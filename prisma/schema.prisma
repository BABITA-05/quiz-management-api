generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String?
  createdAt   DateTime     @default(now())

  quizResults QuizResult[]
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Question {
  id            Int      @id @default(autoincrement())
  subject       String
  difficulty    String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuizResult {
  id                 Int      @id @default(autoincrement())
  playerId           Int
  totalQuestions     Int
  attemptedQuestions Int
  correctAnswers     Int
  wrongAnswers       Int
  finalScore         Int
  percentage         Float
  createdAt          DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
}